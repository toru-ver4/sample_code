#include "drawing.h"

DEFINE_UI_PARAMS(margin_gui, Line Spacing, DCTLUI_SLIDER_INT, 256, 32, 1920, 8)
DEFINE_UI_PARAMS(line_width_gui, Line Width, DCTLUI_SLIDER_INT, 3, 1, 255, 2)
DEFINE_UI_PARAMS(color_val, Line Brightness, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.0001)

// main function
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgb = to_float3(p_R, p_G, p_B);
    float3 out_rgb = rgb;
    float3 fill_color = {color_val, color_val, color_val};
    int margin = _floorf(margin_gui * (p_Height / 1080.0) + 0.5);
    int line_width = _floorf(line_width_gui * (p_Height / 1080.0) + 0.5);
    int num_of_lines = _floorf((p_Width + 2 * p_Height) / float(margin) + 0.5) + 1;
    int h_center = p_Width/2;
    int v_center = p_Height/2;
    int offset_coef;

    for(int ii=0; ii<num_of_lines; ++ii){
        offset_coef = -num_of_lines/2 + ii;
        out_rgb = draw_45deg_line(
            p_Width, p_Height, p_X, p_Y,
            out_rgb,
            margin*offset_coef, h_center, v_center,
            line_width, fill_color
        );
    }

    return out_rgb;
}
