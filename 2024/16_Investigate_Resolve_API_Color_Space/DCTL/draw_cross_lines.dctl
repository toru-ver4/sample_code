#define NUM_OF_LINES   (2)

typedef struct{
    int x;
    int y;
} int2;

__DEVICE__ float3 draw_rectangle(
    int p_Width, int p_Height,
    int p_X, int p_Y,
    float3 rgb_in,
    int2 st_pos, int2 ed_pos, float3 fill_color)
{
    float3 rgb_out = rgb_in;

    if((st_pos.x <= p_X) && (p_X < ed_pos.x)){
        if((st_pos.y <= p_Y) && (p_Y < ed_pos.y)){
            rgb_out.x = fill_color.x;
            rgb_out.y = fill_color.y;
            rgb_out.z = fill_color.z;
        }
    }
    return rgb_out;
}

// main function
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgb = to_float3(p_R, p_G, p_B);
    float3 out_rgb = rgb;
    float3 fill_color = {0.0, 1.0, 1.0};
    int line_width = 4;
    int line_length = (int)(_round(p_Height / 3.0));
    int h_center = p_Width / 2;
    int v_center = p_Height / 2;

    int2 st_pos_list[NUM_OF_LINES] = {
        {h_center - line_length / 2, v_center - line_width / 2},
        {h_center - line_width / 2, v_center - line_length / 2},
    };
    int2 ed_pos_list[NUM_OF_LINES] = {
        {h_center + line_length / 2, v_center + line_width / 2},
        {h_center + line_width / 2, v_center + line_length / 2},
    };
    for(int ii=0; ii<NUM_OF_LINES; ii++){
        out_rgb = draw_rectangle(
            p_Width, p_Height,
            p_X, p_Y,
            out_rgb,
            st_pos_list[ii], ed_pos_list[ii], fill_color);
    }

    return out_rgb;
}
